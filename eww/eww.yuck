;;---------- Battery--------------------
(defpoll BATTERY_PATH :interval "5s" "scripts/update_gauge.sh")

(defwindow battery
    :monitor 0
    :geometry (geometry :x "30px":y "10px")
    :stacking "fg"

    (box :space-evenly false :class "battery"
      (overlay
        (image :class "gauge"
                :path "${BATTERY_PATH}"
                :image-height 45
              )
        (label :class "name"
              :xalign 0.08
              :valign "center"
              :text "Battery")
          )
      (image :class "icon"
       :path "${EWW_BATTERY.BAT0.status == 'Charging' ? './images/Energy_icon.svg' : 'null'}"
       :image-width 35
       :image-height 35
      )
    )
  )

;;------------Clock window---------------
;; Polls system time every second
(defpoll clock_time :interval "1s" "date '+%H:%M'")

;; Clock Widget
(defwidget clock_widget []
  (box :class "clock-box"
       :orientation "v"
       :space-evenly false
       :valign "center"
       :halign "center"
    (label :class "clock-time" :text clock_time)))

;; Clock Window Definition
(defwindow clock
  :monitor 0
  :geometry (geometry
              :x "20px"
              :y "20px"
              :width "200px"
              :height "100px"
              :anchor "bottom right")
  :stacking "fg"
  :exclusive false
  (clock_widget))

;;------------Menu--------------------
(defvar menus '[{"name":"config","widgets":3},{"name":"man","widgets":4},{"name":"message","widgets":2}]')
(defvar selected "")

(defwidget menuButton [name]
  (button :class "dropdown ${name} ${selected == name ? 'active' : ''}"
          :height 45
          :width 45
          :onclick "eww update selected=${selected != name ? name : ''}"
  )
)

(defwidget subMenu [text]
  (label :class "menu-item"
         :height 30
         :width 200
         :text text)
)

(defwidget centerLayout []
  (box :orientation "v" :width 45 :spacing 20 :class "dropdowns" :space-evenly false
    (for menu in menus
      (menuButton :name {menu.name})
    )
  )
)

(defwidget configMenu []
  (box :class "subMenu" :orientation "v" :spacing 4 :space-evenly false 
    (subMenu :text "test")
    (subMenu :text "test")
    (subMenu :text "test")
    (subMenu :text "test")
  )
)

(defwidget manMenu []
  (box :class "subMenu" :orientation "v" :spacing 4 :space-evenly false
    (subMenu :text "test")
    (subMenu :text "test")
  )
)

(defwidget messageMenu []
  (box :class "subMenu" :orientation "v" :spacing 4 :space-evenly false
    (subMenu :text "test")
    (subMenu :text "test")
    (subMenu :text "test")
  )
)

(defwidget rightLayout []
  (box :class "right-panel" :height 100
    (box :visible {selected == "config"} (configMenu))
    (box :visible {selected == "man"} (manMenu))
    (box :visible {selected == "message"} (messageMenu))
  )
)

;; WRAPPED IN A HORIZONTAL BOX ROOT ELEMENT
(defwidget layout []
  (box :orientation "h" :spacing 4 :space-evenly false :height 400 :width 200 
    (centerLayout)
    (rightLayout)
  )
)

(defwindow mainMenu
    :monitor 0
    :geometry (geometry :x "30px" :y "10px")
    :stacking "fg"

    (layout)
)
