;;---------- Battery Polls
(defpoll battery_percent :interval "5s"
  "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 75")

(defpoll battery_status :interval "5s"
  "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo Charging")

(defpoll BATTERY_PATH :interval "1s" "scripts/update_gauge.sh")

(defwindow battery
    :monitor 0
    :geometry (geometry
                    :width "500px"
                    :height "115px"
                    :x "30px"
                    :y "10px"
                    :anchor "top left")
    :stacking "bg"
    :exclusive false

    (box :class "battery-box"
         :orientation "v"
         :space-evenly false
      (label 
          :class "battery-name"
          :halign "start"
          :valign "start"
          :text "Battery")

      (image :path BATTERY_PATH
             :image-width 500
             :image-height 115)
      ))
;;Colors
;;#939409 #B4B733 yellow 54.75%
;;#890034 #AE0750 red  21.25%

;;------------Clock window---------------
;; Polls system time every second
(defpoll clock_time :interval "1s" "date '+%H:%M'")

;; Clock Widget
(defwidget clock_widget []
  (box :class "clock-box"
       :orientation "v"
       :space-evenly false
       :valign "center"
       :halign "center"
    (label :class "clock-time" :text clock_time)))

;; Clock Window Definition
(defwindow clock
  :monitor 0
  :geometry (geometry
              :x "20px"
              :y "20px"
              :width "200px"
              :height "100px"
              :anchor "bottom right")
  :stacking "fg"
  :exclusive false
  (clock_widget))


;; ==========================================
;; VARIABLES (State Management)
;; ==========================================
;;icons
(defvar config_icon "images/Config.svg")
(defvar man_icon "images/Man.svg")
(defvar message_icon "images/Message.svg")
;;functional
(defvar active_menu "")
(defvar menu_columns "[]")
;; ==========================================
;; WIDGET DEFINITIONS
;; ==========================================

(defwidget center_menu []
  (box :class "menu-center" :orientation "vertical" :spacing 10 :space-evenly false
    (button :class "icon-btn"
      :onclick "eww update active_menu=${active_menu!='config'?'config': ''} config_icon=${config_icon=='images/Config.svg'?'images/Config_on.svg':'images/Config.svg'} && /home/swortech/.config/eww/scripts/menu_manager open config"
      (image :class "menu-icon" :path config_icon :halign "center" :valign "center" :image-width 70 :preserve-aspect-ratio true))
    
    (button :class "icon-btn"
      :onclick "eww update man_icon=${man_icon == 'images/Man.svg' ? 'images/Man_on.svg' : 'images/Man.svg'}"
      (image :class "menu-icon" :path man_icon :halign "center" :valign "center" :image-width 70 :preserve-aspect-ratio true))
    
    (button :class "icon-btn"
      :onclick "eww update message_icon=${message_icon == 'images/Message.svg' ? 'images/Message_on.svg' : 'images/Message.svg'}"
      (image :class "menu-icon" :path message_icon :halign "center" :valign "center" :image-width 70 :preserve-aspect-ratio true))
    ))

(defwindow right_menu
  :monitor 0
  :stacking "fg"
  :geometry (geometry
              :anchor "top left"
            )
  (expander  :expanded {active_menu != ""}

    (box :class "columns-container"
         :orientation "vertical"
         :space-evenly true
         :width 900
         :height 200
         (label :text "${menu_columns}")
         (label :text "${menu_columns.config[0].label}")
    )
  )
)

; (defwidget left_menu)

;; ==========================================
;; WINDOW DEFINITION
;; ==========================================
(defwindow main_menu
  :monitor 0
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  :geometry (geometry
              :height "70%"
              :anchor "center"
            )
  (box :class "window-root"
       :orientation "horizontal"
       :space-evenly false
    ; (left_menu)
    (center_menu)
    ; (right_menu)
    ))